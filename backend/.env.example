DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@localhost:5432/NOMBRE_BD
TEST_DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@localhost:5432/NOMBRE_BD_test
# Orígenes permitidos por CORS, en formato JSON (el frontend de Vite usa 5173)
CORS_ORIGINS=["http://localhost:5173"]
# Secreto para firmar los tokens (mínimo 32 caracteres, sin valor por defecto).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Vida del token en minutos (opcional, por defecto 60)
JWT_EXPIRE_MINUTES=60
